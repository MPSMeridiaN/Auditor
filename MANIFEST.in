include CHANGELOG.md
include CODE_OF_CONDUCT.md
include CONTRIBUTING.md
include LICENSE
include README.md
include SECURITY.md
include pyproject.toml
include setup.py
include MANIFEST.in
recursive-include src/coherence *.py

# Tests, fixtures, documentation sources, and Agent Skills are development
# surfaces with their own distribution path. They are intentionally not part
# of the PyPI source archive; the skill archive is built separately.
prune .agents
prune .coherence
prune docs
prune examples
prune skills
prune tests
prune build
prune dist
prune release
prune release-evidence
prune reports
prune src/system_coherence.egg-info
exclude src/system_coherence.egg-info/*
recursive-exclude src/system_coherence.egg-info *
global-exclude .env*
global-exclude *.bak
global-exclude *.log
global-exclude *.pyc
global-exclude *.pyo
global-exclude __pycache__/*
